---
import PageLayout from './PageLayout.astro';
import type { CollectionEntry } from 'astro:content';
import type { SupportedLanguage } from '../types';
import { getAssetUrl, getRelativeLocaleUrl } from '../utils/paths';
import { getUi } from '../utils/i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  currentLocale: SupportedLanguage;
}

const { project, currentLocale } = Astro.props;
const data = project.data;
const ui = getUi(currentLocale);
const categoryLabel = ui.projectCategories[data.category] || data.category;
const backUrl = getRelativeLocaleUrl(currentLocale, 'projects');
---

<PageLayout 
  title={data.title[currentLocale]} 
  description={data.description[currentLocale]} 
  currentLocale={currentLocale}
  ogImage={data.thumbnail}
>
  <article class="project-detail container section-spacing">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={backUrl} class="back-link">
        {ui.common.backToProjects}
      </a>
    </nav>

    <header class="detail-header">
      <div class="detail-meta">
        <span class="badge badge-category">{categoryLabel}</span>
        <span class:list={['badge-status', `status-${data.timeline.status}`]}>
          {data.timeline.status === 'completed' && ui.common.completed}
          {data.timeline.status === 'in-progress' && ui.common.inProgress}
          {data.timeline.status === 'archived' && ui.common.archived}
        </span>
        <span class="detail-timeline-dates">
          {data.timeline.startDate} {data.timeline.completionDate ? `— ${data.timeline.completionDate}` : `— ${ui.common.inProgress}`}
        </span>
      </div>

      <h1 class="detail-title">{data.title[currentLocale]}</h1>
      <p class="detail-lead">{data.description[currentLocale]}</p>

      <!-- Action buttons -->
      <div class="detail-actions">
        {data.links.github && (
          <a href={data.links.github} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
            {ui.common.sourceCode} ↗
          </a>
        )}
        {data.links.demo && (
          <a href={data.links.demo} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            {ui.common.liveDemo} ↗
          </a>
        )}
        {data.links.paper && (
          <a href={data.links.paper} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            📄 {ui.common.paper} ↗
          </a>
        )}
      </div>
    </header>

    <!-- Thumbnail Banner -->
    <div class="detail-banner">
      <img src={getAssetUrl(data.thumbnail)} alt={data.title[currentLocale]} class="banner-img" />
    </div>

    <!-- Structured Academic Dossier Grid -->
    <section class="academic-dossier">
      <h2 class="dossier-heading">{ui.common.academicDetails}</h2>

      <div class="dossier-grid">
        <div class="dossier-card">
          <h3 class="dossier-subhead">👤 {ui.common.individualContribution}</h3>
          <p>{data.academic.individualContribution[currentLocale]}</p>
        </div>

        {data.academic.methodology && (
          <div class="dossier-card">
            <h3 class="dossier-subhead">⚙️ {ui.common.methodology}</h3>
            <p>{data.academic.methodology[currentLocale]}</p>
          </div>
        )}

        {data.academic.results && (
          <div class="dossier-card">
            <h3 class="dossier-subhead">📊 {ui.common.results}</h3>
            <p>{data.academic.results[currentLocale]}</p>
          </div>
        )}

        {data.academic.limitations && (
          <div class="dossier-card">
            <h3 class="dossier-subhead">⚠️ {ui.common.limitations}</h3>
            <p>{data.academic.limitations[currentLocale]}</p>
          </div>
        )}
      </div>
    </section>

    <!-- Technologies Section -->
    <section class="detail-tech-section">
      <h3 class="tech-heading">{ui.common.technologies}</h3>
      <div class="tech-pills-wrap">
        {data.technologies.map((tech) => (
          <span class="tech-tag">{tech}</span>
        ))}
      </div>
    </section>

    <!-- Long-form Markdown Content Body -->
    <section class="prose-content">
      <slot />
    </section>
  </article>
</PageLayout>

<style>
  .project-detail {
    max-width: var(--max-width-content);
  }

  .breadcrumb {
    margin-bottom: var(--space-6);
  }

  .back-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    display: inline-flex;
    align-items: center;
  }

  .back-link:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .detail-header {
    margin-bottom: var(--space-8);
  }

  .detail-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .detail-timeline-dates {
    font-size: 0.875rem;
    color: var(--color-text-subtle);
  }

  .badge-status {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .status-completed {
    background-color: #dcfce7;
    color: #15803d;
  }

  .status-in-progress {
    background-color: #fef3c7;
    color: #b45309;
  }

  .status-archived {
    background-color: #f1f5f9;
    color: #64748b;
  }

  .detail-title {
    font-size: 2.25rem;
    color: var(--color-primary);
    line-height: 1.25;
    margin-bottom: var(--space-4);
  }

  .detail-lead {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: var(--max-width-prose);
    margin-bottom: var(--space-6);
  }

  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .detail-banner {
    width: 100%;
    aspect-ratio: 21 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-10);
    border: 1px solid var(--color-border);
    background-color: var(--color-primary);
  }

  .banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .academic-dossier {
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-bottom: var(--space-10);
  }

  .dossier-heading {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-accent-subtle);
  }

  .dossier-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .dossier-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .dossier-card {
    background-color: var(--color-bg);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .dossier-subhead {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .dossier-card p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .detail-tech-section {
    margin-bottom: var(--space-10);
  }

  .tech-heading {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .tech-pills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tech-tag {
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    background-color: var(--color-accent-subtle);
    color: var(--color-accent);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-md);
  }

  .prose-content {
    max-width: var(--max-width-prose);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .prose-content :global(h2), .prose-content :global(h3) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .prose-content :global(p) {
    margin-bottom: var(--space-4);
  }
</style>
