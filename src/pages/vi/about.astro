---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/common/SectionHeading.astro';
import EducationTimeline from '../../components/timeline/EducationTimeline.astro';
import profileData from '../../data/profile.json';
import educationData from '../../data/education.json';
import { getRelativeLocaleUrl } from '../../utils/paths';

const currentLocale = 'vi';
---

<PageLayout 
  title="Giới thiệu & Quá trình Học vấn" 
  description="Thông tin chi tiết về quá trình học tập tại UIT – ĐHQG-HCM, định hướng nghiên cứu và mục tiêu nghề nghiệp của Trương Quốc Nam."
  currentLocale={currentLocale}
>
  <div class="container section-spacing">
    <SectionHeading 
      title="Giới thiệu & Học vấn" 
      subtitle="Hành trình học tập chuyên sâu tại Trường Đại học Công nghệ Thông tin, Đại học Quốc gia TP. Hồ Chí Minh."
    />

    <!-- Main About Grid -->
    <div class="about-grid">
      <div class="about-main-text">
        <h3 class="about-subhead">Giới thiệu bản thân</h3>
        <p class="about-paragraph">{profileData.bio[currentLocale]}</p>
        <p class="about-paragraph">
          Tại UIT, tôi theo đuổi chương trình đào tạo chính quy ngành Khoa học Máy tính. Với quan điểm kỹ thuật vững chắc phải bắt nguồn từ nền tảng toán học và cấu trúc dữ liệu căn bản, tôi dành sự tập trung cao độ vào việc rèn luyện thuật toán thông qua lập trình thi đấu và thực hiện các đề tài nghiên cứu học thuật về Trí tuệ Nhân tạo và Thị giác Máy tính.
        </p>

        <h3 class="about-subhead">Mục tiêu Học thuật & Nghiên cứu</h3>
        <ul class="academic-goals-list">
          <li>
            <strong>Nền tảng Toán & Giải thuật:</strong> Hoàn thiện các chuyên đề toán giải tích, đại số tuyến tính, xác suất thống kê và hệ thống hóa thư viện giải thuật đạt chuẩn ICPC.
          </li>
          <li>
            <strong>Nghiên cứu Thị giác Máy tính (CV):</strong> Tìm hiểu sâu các kiến trúc mạng nơ-ron học sâu (Deep CNN, Transformers) và cơ chế Attention ứng dụng trong phân đoạn ngữ nghĩa ảnh.
          </li>
          <li>
            <strong>Chuẩn mực Kỹ thuật Phần mềm:</strong> Rèn luyện tác phong viết mã nguồn sạch (Clean Code), kiến trúc module hóa và quy trình DevOps tự động hóa khép kín.
          </li>
        </ul>
      </div>

      <div class="about-aside">
        <div class="aside-card">
          <h4 class="aside-title">Thông tin tóm tắt</h4>
          <dl class="aside-dl">
            <dt>Họ và tên:</dt>
            <dd>{profileData.name[currentLocale]}</dd>
            
            <dt>Trường đại học:</dt>
            <dd>{profileData.institution[currentLocale]}</dd>

            <dt>Khoa đào tạo:</dt>
            <dd>{profileData.faculty[currentLocale]}</dd>

            <dt>Chuyên ngành:</dt>
            <dd>{profileData.program[currentLocale]}</dd>

            <dt>Khóa sinh viên:</dt>
            <dd>{profileData.currentYear[currentLocale]}</dd>

            <dt>Email học thuật:</dt>
            <dd>
              <a href={`mailto:${profileData.contacts.email}`}>{profileData.contacts.email}</a>
            </dd>
          </dl>
        </div>
      </div>
    </div>

    <!-- Career Directions -->
    <section class="career-section">
      <SectionHeading 
        title="Định hướng Nghề nghiệp & Chuyên môn" 
        subtitle="Hai trụ cột kỹ thuật trọng tâm trong quá trình học tập và phát triển nghề nghiệp."
      />

      <div class="career-grid">
        {profileData.careerDirections.map((dir) => (
          <div class="career-card">
            <h3 class="career-title">{dir.title[currentLocale]}</h3>
            <p class="career-desc">{dir.description[currentLocale]}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Education Timeline -->
    <section class="education-section">
      <SectionHeading 
        title="Lộ trình Đào tạo Học vấn" 
        subtitle="Quá trình đào tạo chính quy và các học phần chuyên sâu tại UIT."
      />

      <EducationTimeline education={educationData as any} currentLocale={currentLocale} />
    </section>
  </div>
</PageLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    margin-bottom: var(--space-16);
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  .about-subhead {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .about-subhead:first-of-type {
    margin-top: 0;
  }

  .about-paragraph {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: var(--space-4);
  }

  .academic-goals-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: disc;
    padding-left: var(--space-5);
  }

  .academic-goals-list li {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .academic-goals-list strong {
    color: var(--color-primary);
  }

  .aside-card {
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .aside-title {
    font-size: 1.125rem;
    color: var(--color-primary);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-accent-subtle);
  }

  .aside-dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3) var(--space-4);
    font-size: 0.875rem;
  }

  .aside-dl dt {
    color: var(--color-text-subtle);
    font-weight: 500;
  }

  .aside-dl dd {
    color: var(--color-primary);
    font-weight: 600;
  }

  .aside-dl a {
    color: var(--color-accent);
  }

  .career-section {
    margin-bottom: var(--space-16);
  }

  .career-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .career-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .career-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    border-left: 4px solid var(--color-accent);
  }

  .career-title {
    font-size: 1.125rem;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .career-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
</style>
