---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/common/SectionHeading.astro';
import SocialLinks from '../../components/common/SocialLinks.astro';
import profileData from '../../data/profile.json';
import { getAssetUrl } from '../../utils/paths';
import { getUi } from '../../utils/i18n';

const currentLocale = 'vi';
const ui = getUi(currentLocale);
---

<PageLayout 
  title="Liên hệ & Hồ sơ Học thuật (CV)" 
  description="Thông tin liên lạc chính thức, tải CV học thuật và định hướng hợp tác nghiên cứu cùng Trương Quốc Nam."
  currentLocale={currentLocale}
>
  <div class="container section-spacing">
    <SectionHeading 
      title="Liên hệ & Hồ sơ Học thuật (CV)" 
      subtitle="Kênh liên lạc chính thức phục vụ trao đổi học thuật, nghiên cứu khoa học và cơ hội cộng tác kỹ thuật."
    />

    <div class="contact-grid">
      <!-- Contact Cards -->
      <div class="contact-info-col">
        <div class="contact-card">
          <h3 class="card-heading">📬 Email Học thuật</h3>
          <p class="card-desc">
            Vui lòng gửi email trực tiếp để trao đổi về các đề tài nghiên cứu, tài liệu học thuật hoặc hoạt động học tập tại UIT.
          </p>
          <a href={`mailto:${profileData.contacts.email}`} class="contact-email-link">
            {profileData.contacts.email}
          </a>
        </div>

        <div class="contact-card">
          <h3 class="card-heading">🤝 Định hướng Hợp tác</h3>
          <p class="card-desc">
            {profileData.contacts.collaborationInterests[currentLocale]}
          </p>
        </div>

        <div class="contact-card">
          <h3 class="card-heading">🌐 Kênh Kết nối Trực tuyến</h3>
          <div class="social-links-container">
            <SocialLinks 
              email={profileData.contacts.email} 
              github={profileData.contacts.github} 
              linkedin={profileData.contacts.linkedin} 
            />
          </div>
        </div>
      </div>

      <!-- CV Download Box -->
      <div class="cv-download-col">
        <div class="cv-card">
          <div class="cv-icon" aria-hidden="true">📄</div>
          <h3 class="cv-title">Curriculum Vitae (CV Học thuật)</h3>
          <p class="cv-desc">
            Bản tóm tắt toàn diện về lộ trình học tập, các môn học chuyên sâu, đồ án kỹ thuật và thành tích nghiên cứu khoa học.
          </p>

          <div class="cv-meta">
            <p><strong>Định dạng:</strong> PDF (A4 Chuẩn)</p>
            <p><strong>Cập nhật lần cuối:</strong> {profileData.cv.lastUpdated || '2026'}</p>
          </div>

          {profileData.cv.available ? (
            <a 
              href={getAssetUrl(`documents/${profileData.cv.fileName}`)} 
              class="btn btn-primary cv-btn" 
              download
            >
              📥 {ui.common.downloadCv}
            </a>
          ) : (
            <div class="cv-notice-box">
              <span class="btn btn-outline btn-disabled">
                ⏳ {ui.common.cvUnavailable}
              </span>
              <p class="cv-subnote">
                Tệp CV học thuật định dạng PDF đang trong quá trình rà soát và cập nhật điểm số học kỳ mới nhất.
              </p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</PageLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 860px) {
    .contact-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .card-heading {
    font-size: 1.125rem;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .card-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .contact-email-link {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: underline;
  }

  .social-links-container {
    margin-top: var(--space-2);
  }

  .cv-card {
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .cv-icon {
    font-size: 3rem;
    margin-bottom: var(--space-3);
  }

  .cv-title {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .cv-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    max-width: 380px;
    line-height: 1.6;
  }

  .cv-meta {
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-6);
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    width: 100%;
    max-width: 320px;
  }

  .cv-btn {
    width: 100%;
    max-width: 320px;
  }

  .cv-notice-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    max-width: 320px;
  }

  .btn-disabled {
    opacity: 0.7;
    cursor: not-allowed;
    width: 100%;
  }

  .cv-subnote {
    font-size: 0.75rem;
    color: var(--color-text-subtle);
  }
</style>
