---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/common/SectionHeading.astro';
import AchievementCard from '../../components/cards/AchievementCard.astro';
import EmptyState from '../../components/common/EmptyState.astro';
import { getCollection } from 'astro:content';
import { getUi } from '../../utils/i18n';

const currentLocale = 'en';
const ui = getUi(currentLocale);

// Fetch published achievements (initially empty)
const achievements = await getCollection('achievements', ({ data }) => data.published);
achievements.sort((a, b) => b.data.date.localeCompare(a.data.date));

const categories: { key: string; label: string }[] = [
  { key: 'all', label: ui.common.filterAll },
  { key: 'awards', label: ui.achievementCategories['awards'] },
  { key: 'scholarships', label: ui.achievementCategories['scholarships'] },
  { key: 'competitions', label: ui.achievementCategories['competitions'] },
  { key: 'certificates', label: ui.achievementCategories['certificates'] },
  { key: 'academic-activities', label: ui.achievementCategories['academic-activities'] },
  { key: 'research-activities', label: ui.achievementCategories['research-activities'] },
];
---

<PageLayout 
  title="Academic Achievements & Honors" 
  description="Verified academic awards, competitive programming honors, and official certificates of Truong Quoc Nam."
  currentLocale={currentLocale}
>
  <div class="container section-spacing">
    <SectionHeading 
      title="Achievements & Honors" 
      subtitle="Documented repository of verifiable academic awards, scholarships, and competitive milestones."
    />

    <!-- Policy Banner: Evidence Rigor -->
    <div class="policy-note">
      <p>
        <strong>Academic Transparency Policy:</strong> All achievements, awards, and certificates listed herein are backed by verifiable official credentials, university decisions, or documentary evidence available for verification.
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="category-tabs" role="tablist" aria-label="Filter achievements">
      {categories.map((cat, idx) => (
        <button 
          type="button" 
          role="tab" 
          class:list={['cat-tab-btn', { 'active': idx === 0 }]}
          data-cat={cat.key}
          aria-selected={idx === 0 ? 'true' : 'false'}
        >
          {cat.label}
        </button>
      ))}
    </div>

    {achievements.length === 0 ? (
      <EmptyState 
        title={ui.common.emptyAchievementsTitle}
        description={ui.common.emptyAchievementsDesc}
        icon="📜"
      />
    ) : (
      <div id="achievements-grid" class="achievements-grid">
        {achievements.map((item) => (
          <AchievementCard achievement={item} currentLocale={currentLocale} />
        ))}
      </div>
    )}
  </div>
</PageLayout>

<style>
  .policy-note {
    background-color: var(--color-bg-subtle);
    border-left: 4px solid var(--color-accent);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-8);
  }

  .policy-note p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .policy-note strong {
    color: var(--color-primary);
  }

  .category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .cat-tab-btn {
    padding: 0.45rem 0.85rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .cat-tab-btn:hover {
    color: var(--color-primary);
    border-color: var(--color-border-hover);
  }

  .cat-tab-btn.active {
    background-color: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
  }

  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }
</style>
