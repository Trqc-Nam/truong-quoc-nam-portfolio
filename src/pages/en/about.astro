---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/common/SectionHeading.astro';
import EducationTimeline from '../../components/timeline/EducationTimeline.astro';
import profileData from '../../data/profile.json';
import educationData from '../../data/education.json';
import { getRelativeLocaleUrl } from '../../utils/paths';

const currentLocale = 'en';
---

<PageLayout 
  title="About & Academic Background" 
  description="Academic background at UIT – VNU-HCM, research interests, and career objectives of Truong Quoc Nam."
  currentLocale={currentLocale}
>
  <div class="container section-spacing">
    <SectionHeading 
      title="About & Education" 
      subtitle="Scholarly journey in the Department of Computer Science at UIT – VNU-HCM."
    />

    <!-- Main About Grid -->
    <div class="about-grid">
      <div class="about-main-text">
        <h3 class="about-subhead">Personal Introduction</h3>
        <p class="about-paragraph">{profileData.bio[currentLocale]}</p>
        <p class="about-paragraph">
          At UIT, I am pursuing a Bachelor of Science in Computer Science. Grounded in the conviction that resilient software engineering requires deep mathematical foundations and rigorous algorithmic mastery, I concentrate heavily on competitive programming benchmarks and experimental applied research in Artificial Intelligence and Computer Vision.
        </p>

        <h3 class="about-subhead">Academic & Scholarly Goals</h3>
        <ul class="academic-goals-list">
          <li>
            <strong>Mathematical & Algorithmic Rigor:</strong> Master discrete mathematics, linear algebra, and probability theory while curating an ICPC-grade algorithmic template repository.
          </li>
          <li>
            <strong>Computer Vision (CV) Research:</strong> Investigate deep neural architectures (CNNs, Vision Transformers) and attention mechanisms applied to semantic visual segmentation.
          </li>
          <li>
            <strong>Software Engineering Best Practices:</strong> Uphold clean architecture, modular system design, and automated reproducible CI/CD testing pipelines.
          </li>
        </ul>
      </div>

      <div class="about-aside">
        <div class="aside-card">
          <h4 class="aside-title">Academic Profile</h4>
          <dl class="aside-dl">
            <dt>Full Name:</dt>
            <dd>{profileData.name[currentLocale]}</dd>
            
            <dt>University:</dt>
            <dd>{profileData.institution[currentLocale]}</dd>

            <dt>Faculty:</dt>
            <dd>{profileData.faculty[currentLocale]}</dd>

            <dt>Program:</dt>
            <dd>{profileData.program[currentLocale]}</dd>

            <dt>Status:</dt>
            <dd>{profileData.currentYear[currentLocale]}</dd>

            <dt>Academic Email:</dt>
            <dd>
              <a href={`mailto:${profileData.contacts.email}`}>{profileData.contacts.email}</a>
            </dd>
          </dl>
        </div>
      </div>
    </div>

    <!-- Career Directions -->
    <section class="career-section">
      <SectionHeading 
        title="Career & Technical Directions" 
        subtitle="Two primary technical pillars guiding my curriculum and professional development."
      />

      <div class="career-grid">
        {profileData.careerDirections.map((dir) => (
          <div class="career-card">
            <h3 class="career-title">{dir.title[currentLocale]}</h3>
            <p class="career-desc">{dir.description[currentLocale]}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Education Timeline -->
    <section class="education-section">
      <SectionHeading 
        title="Education Curriculum Timeline" 
        subtitle="Formal academic milestones and specialized coursework at UIT."
      />

      <EducationTimeline education={educationData as any} currentLocale={currentLocale} />
    </section>
  </div>
</PageLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    margin-bottom: var(--space-16);
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  .about-subhead {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .about-subhead:first-of-type {
    margin-top: 0;
  }

  .about-paragraph {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: var(--space-4);
  }

  .academic-goals-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: disc;
    padding-left: var(--space-5);
  }

  .academic-goals-list li {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .academic-goals-list strong {
    color: var(--color-primary);
  }

  .aside-card {
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .aside-title {
    font-size: 1.125rem;
    color: var(--color-primary);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-accent-subtle);
  }

  .aside-dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3) var(--space-4);
    font-size: 0.875rem;
  }

  .aside-dl dt {
    color: var(--color-text-subtle);
    font-weight: 500;
  }

  .aside-dl dd {
    color: var(--color-primary);
    font-weight: 600;
  }

  .aside-dl a {
    color: var(--color-accent);
  }

  .career-section {
    margin-bottom: var(--space-16);
  }

  .career-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .career-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .career-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    border-left: 4px solid var(--color-accent);
  }

  .career-title {
    font-size: 1.125rem;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .career-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
</style>
