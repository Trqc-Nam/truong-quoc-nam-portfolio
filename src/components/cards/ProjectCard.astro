---
import type { CollectionEntry } from 'astro:content';
import type { SupportedLanguage } from '../../types';
import { getAssetUrl, getRelativeLocaleUrl } from '../../utils/paths';
import { getUi } from '../../utils/i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  currentLocale: SupportedLanguage;
}

const { project, currentLocale } = Astro.props;
const data = project.data;
const ui = getUi(currentLocale);
const detailUrl = getRelativeLocaleUrl(currentLocale, `projects/${project.slug}`);
const categoryName = ui.projectCategories[data.category] || data.category;
---

<article class="project-card" data-category={data.category} data-tech={data.technologies.join(' ').toLowerCase()} data-title={data.title[currentLocale].toLowerCase()}>
  <div class="card-thumb-wrap">
    <a href={detailUrl} tabindex="-1" aria-hidden="true">
      <img 
        src={getAssetUrl(data.thumbnail)} 
        alt={data.title[currentLocale]} 
        loading="lazy" 
        class="card-thumb"
      />
    </a>
    {data.featured && (
      <span class="badge-featured" aria-label="Featured Project">
        ★ {currentLocale === 'vi' ? 'Tiêu biểu' : 'Featured'}
      </span>
    )}
  </div>

  <div class="card-body">
    <div class="card-meta">
      <span class="badge badge-category">{categoryName}</span>
      <span class:list={['badge-status', `status-${data.timeline.status}`]}>
        {data.timeline.status === 'completed' && ui.common.completed}
        {data.timeline.status === 'in-progress' && ui.common.inProgress}
        {data.timeline.status === 'archived' && ui.common.archived}
      </span>
    </div>

    <h3 class="card-title">
      <a href={detailUrl}>{data.title[currentLocale]}</a>
    </h3>

    <p class="card-desc">
      {data.description[currentLocale]}
    </p>

    <div class="card-tech-list">
      {data.technologies.slice(0, 4).map((tech) => (
        <span class="tech-pill">{tech}</span>
      ))}
      {data.technologies.length > 4 && (
        <span class="tech-pill tech-more">+{data.technologies.length - 4}</span>
      )}
    </div>

    <div class="card-footer">
      <a href={detailUrl} class="btn-detail">
        {ui.common.viewDetails} →
      </a>

      <div class="card-ext-links">
        {data.links.github && (
          <a 
            href={data.links.github} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="ext-icon-link"
            title={ui.common.sourceCode}
            aria-label={`${ui.common.sourceCode} for ${data.title[currentLocale]}`}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
          </a>
        )}
        {data.links.demo && (
          <a 
            href={data.links.demo} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="ext-icon-link"
            title={ui.common.liveDemo}
            aria-label={`${ui.common.liveDemo} for ${data.title[currentLocale]}`}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-border-hover);
  }

  .card-thumb-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    background-color: var(--color-primary-light);
    overflow: hidden;
  }

  .card-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .project-card:hover .card-thumb {
    transform: scale(1.02);
  }

  .badge-featured {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background-color: #f59e0b;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
  }

  .card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .badge-category {
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 200px;
  }

  .badge-status {
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  .status-completed {
    background-color: #dcfce7;
    color: #15803d;
  }

  .status-in-progress {
    background-color: #fef3c7;
    color: #b45309;
  }

  .status-archived {
    background-color: #f1f5f9;
    color: #64748b;
  }

  .card-title {
    font-size: 1.125rem;
    line-height: 1.4;
    margin-bottom: var(--space-2);
  }

  .card-title a {
    color: var(--color-primary);
    transition: color var(--transition-fast);
  }

  .card-title a:hover {
    color: var(--color-accent);
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .card-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: var(--space-4);
  }

  .tech-pill {
    font-size: 0.6875rem;
    font-weight: 500;
    padding: 0.15rem 0.45rem;
    background-color: var(--color-bg-subtle);
    color: var(--color-text-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .tech-more {
    font-weight: 600;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .btn-detail {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    display: inline-flex;
    align-items: center;
    transition: color var(--transition-fast);
  }

  .btn-detail:hover {
    color: var(--color-accent-hover);
  }

  .card-ext-links {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .ext-icon-link {
    display: flex;
    align-items: center;
    color: var(--color-text-subtle);
    padding: 0.25rem;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast);
  }

  .ext-icon-link:hover {
    color: var(--color-primary);
  }
</style>
