---
import type { EducationEntry, SupportedLanguage } from '../../types';

interface Props {
  education: EducationEntry[];
  currentLocale: SupportedLanguage;
}

const { education, currentLocale } = Astro.props;
---

<div class="timeline-container">
  {education.map((item) => (
    <article class="timeline-item">
      <div class="timeline-marker" aria-hidden="true"></div>
      
      <div class="timeline-content">
        <div class="timeline-header">
          <span class="timeline-period">{item.period[currentLocale]}</span>
          <span class="badge badge-neutral">{item.status[currentLocale]}</span>
        </div>

        <h3 class="timeline-degree">{item.degree[currentLocale]}</h3>
        <h4 class="timeline-institution">{item.institution[currentLocale]}</h4>
        <p class="timeline-major">
          <strong>{currentLocale === 'vi' ? 'Chuyên ngành:' : 'Major:'}</strong> {item.major[currentLocale]}
        </p>

        {item.description && (
          <p class="timeline-desc">{item.description[currentLocale]}</p>
        )}

        {item.relevantCoursework && item.relevantCoursework.length > 0 && (
          <div class="timeline-coursework">
            <span class="coursework-label">
              {currentLocale === 'vi' ? 'Học phần tiêu biểu:' : 'Key Coursework:'}
            </span>
            <ul class="coursework-list">
              {item.relevantCoursework.map((course) => (
                <li class="coursework-pill">{course[currentLocale]}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </article>
  ))}
</div>

<style>
  .timeline-container {
    position: relative;
    padding-left: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .timeline-container::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 7px;
    width: 2px;
    background-color: var(--color-border);
  }

  .timeline-item {
    position: relative;
  }

  .timeline-marker {
    position: absolute;
    top: 6px;
    left: calc(-1 * var(--space-8) + 3px);
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    border: 2px solid var(--color-bg);
    box-shadow: 0 0 0 3px var(--color-accent-subtle);
  }

  .timeline-content {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .timeline-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .timeline-period {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .timeline-degree {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: var(--space-1);
  }

  .timeline-institution {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .timeline-major {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .timeline-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .timeline-coursework {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .coursework-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .coursework-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .coursework-pill {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }
</style>
