---
import { getUi } from '../../utils/i18n';
import siteSettings from '../../data/site-settings.json';
import type { SupportedLanguage } from '../../types';

interface Props {
  currentLocale: SupportedLanguage;
}

const { currentLocale } = Astro.props;
const ui = getUi(currentLocale);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-identity">
        <h3 class="footer-name">Trương Quốc Nam</h3>
        <p class="footer-sub">{ui.siteSubtitle}</p>
        <p class="footer-affiliation">
          {currentLocale === 'vi' 
            ? 'Trường Đại học Công nghệ Thông tin, Đại học Quốc gia TP. Hồ Chí Minh'
            : 'University of Information Technology, Vietnam National University Ho Chi Minh City'}
        </p>
      </div>

      <div class="footer-nav">
        <h4 class="footer-heading">{currentLocale === 'vi' ? 'Liên kết nhanh' : 'Quick Links'}</h4>
        <ul class="footer-links-list">
          {siteSettings.navItems.map((item) => (
            <li>
              <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/${currentLocale}/${item.path ? item.path + '/' : ''}`}>
                {item.label[currentLocale]}
              </a>
            </li>
          ))}
          <li>
            <a href={siteSettings.repository} target="_blank" rel="noopener noreferrer">
              GitHub Repository ↗
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">{ui.common.allRightsReserved}</p>
      <p class="footer-notice">{ui.common.footerNotice}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-primary);
    color: #cbd5e1;
    border-top: 1px solid var(--color-primary-light);
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
    margin-top: auto;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .footer-top {
      grid-template-columns: 2fr 1fr;
    }
  }

  .footer-name {
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: var(--space-1);
  }

  .footer-sub {
    color: #94a3b8;
    font-size: 0.9375rem;
    margin-bottom: var(--space-2);
  }

  .footer-affiliation {
    color: #64748b;
    font-size: 0.8125rem;
    max-width: 480px;
  }

  .footer-heading {
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .footer-links-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-links-list a {
    color: #94a3b8;
    font-size: 0.875rem;
    transition: color var(--transition-fast);
  }

  .footer-links-list a:hover {
    color: #ffffff;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8125rem;
    color: #64748b;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer-copy, .footer-notice {
    color: #64748b;
  }
</style>
